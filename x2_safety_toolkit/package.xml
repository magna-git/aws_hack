<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>x2_safety_toolkit</name>
  <version>0.0.0</version>
  <description>
    X2 Perception Safety Toolkit: LiDAR inspection, obstacle detection,
    a local 2D safety map and a dry-run-first safe velocity controller
    built on the chest-front LiDAR, used in place of the unavailable
    official SLAM stack.
  </description>
  <maintainer email="dell@example.com">dell</maintainer>
  <license>TODO: License declaration</license>

  <depend>aimdk_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
